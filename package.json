    "@cdktf/hcl2json": "0.21.0",
    "@readme/openapi-parser": "10.0.0",
    "@scip-code/scip": "0.10.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "dockerfile-ast": "0.7.1",
    "graphql": "17.0.2",
    "node-sql-parser": "5.4.0",
