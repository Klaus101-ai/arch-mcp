{
  "name": "arch-mcp",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "MCP server that maps a repository into a graph of files, imports, SQL, API contracts and infra, and answers what a change breaks (stdio)",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "arch-mcp": "dist/server.mjs",
    "arch-mcp-cli": "dist/cli.mjs"
  },
  "files": [
    "dist/*.mjs",
    "grammars/*.wasm",
    "grammars/LICENSE",
    "grammars/SHA256SUMS",
    "python/sqlglot_bridge.py",
    "THIRD_PARTY_NOTICES.md",
    "README.ru.md"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "prebootstrap": "node esbuild.mjs",
    "bootstrap": "node dist/cli.mjs bootstrap",
    "test": "node esbuild.mjs && node --test \"tests/*.test.mjs\"",
    "prepublishOnly": "node esbuild.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Klaus101-ai/arch-mcp.git"
  },
  "homepage": "https://github.com/Klaus101-ai/arch-mcp#readme",
  "bugs": {
    "url": "https://github.com/Klaus101-ai/arch-mcp/issues"
  },
  "keywords": ["mcp", "mcp-server", "architecture", "dependency-graph", "static-analysis", "tree-sitter", "sql", "typescript", "nodejs"],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@repomix/tree-sitter-wasms": "0.1.17",
    "@types/node": "^22.20.5",
    "@unit-mesh/treesitter-artifacts": "1.7.7",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@asyncapi/parser": "3.6.6",
    "@bufbuild/protobuf": "2.16.0",
    "@cdktf/hcl2json": "0.21.0",
    "@readme/openapi-parser": "10.0.0",
    "@scip-code/scip": "0.10.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "dockerfile-ast": "0.7.1",
    "graphql": "17.0.2",
    "node-sql-parser": "5.4.0",
    "protobufjs": "8.8.1",
    "remark": "15.0.1",
    "smol-toml": "1.9.1",
    "web-tree-sitter": "0.27.1",
    "yaml": "2.9.1"
  }
}
